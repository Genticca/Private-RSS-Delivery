<tr id="group-{{id}}" data-id="{{id}}">
  <td>
    <button type="button" class="group-identity" data-edit-group="{{id}}">
      <span class="source-avatar">
        {{#if webhookAvatarUrl}}<img class="avatar-preview" src="{{webhookAvatarUrl}}" alt="">{{else}}{{> icon name="layers"}}{{/if}}
      </span>
      <strong>{{name}}</strong>
    </button>
  </td>
  <td><span class="group-webhook" title="{{maskedWebhookUrl}}">{{#if hasWebhook}}{{maskedWebhookUrl}}{{else}}<span class="muted">웹훅 미설정</span>{{/if}}</span></td>
  <td>{{#if webhookName}}{{webhookName}}{{else}}<span class="muted">웹훅 기본값</span>{{/if}}</td>
  <td><span class="badge {{#if hasWebhook}}ok{{else}}warn{{/if}}">{{#if hasWebhook}}연결됨{{else}}미연결{{/if}}</span></td>
  <td class="align-right">
    <details class="row-menu">
      <summary class="icon-button" aria-label="{{name}} 그룹 작업">{{> icon name="more"}}</summary>
      <div class="row-menu-content">
        <button type="button" data-edit-group="{{id}}">발신 그룹 설정</button>
        <button class="danger-text" hx-delete="/api/groups/{{id}}" hx-confirm="이 발신 그룹을 삭제할까요?" hx-target="closest tr" hx-swap="delete">그룹 삭제</button>
      </div>
    </details>
  </td>
</tr>
