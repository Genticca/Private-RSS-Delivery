<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f7f9f9">
  <meta name="htmx-config" content='{"ignoreTitle":true}'>
  <title>{{#if title}}{{title}} · {{/if}}RSS Bridge</title>
  <link rel="stylesheet" href="/assets/css/app.css">
  {{#if needsCodeMirror}}<link rel="stylesheet" href="/assets/css/codemirror.css">{{/if}}
  <script src="/assets/js/htmx.min.js" defer>
</script>
  {{#if needsCodeMirror}}<script src="/assets/js/codemirror.js" defer>
</script>{{/if}}
  <script src="/assets/js/app.js" defer>
</script>
</head>
<body hx-indicator="#global-indicator">
  {{> icons}}
  <a class="skip-link" href="#main-content">본문으로 이동</a>
  <div class="app-layout">
    <button class="sidebar-backdrop" data-close-nav aria-label="메뉴 닫기" hidden>
</button>
    <aside class="sidebar" id="main-sidebar">
      <a class="brand" href="/" aria-label="RSS Bridge 홈">
<span class="brand-mark">{{> icon name="bridge"}}</span>
<span>RSS Bridge<span class="brand-caption">YOUR FEEDS, CONNECTED.</span>
</span>
</a>
      <nav class="sidebar-nav" aria-label="주 메뉴">
        <p class="nav-section-label">운영</p>
        <a href="/" class="nav-item" id="nav-dashboard">{{> icon name="dashboard"}}<span>운영 개요</span>
</a>
        <a href="/sources" class="nav-item" id="nav-sources">{{> icon name="rss"}}<span>수집 소스</span>
</a>
        <a href="/groups" class="nav-item" id="nav-groups">{{> icon name="layers"}}<span>발신 그룹</span>
</a>
        <a href="/delivery-jobs" class="nav-item" id="nav-delivery-jobs">{{> icon name="send"}}<span>발송 검토</span>
</a>
        <p class="nav-section-label">도구 및 모니터링</p>
        <a href="/templates" class="nav-item" id="nav-templates">{{> icon name="template"}}<span>메시지 템플릿</span>
</a>
        <a href="/model" class="nav-item" id="nav-model">{{> icon name="sparkles"}}<span>AI 번역</span>
</a>
        <a href="/logs" class="nav-item" id="nav-logs">{{> icon name="activity"}}<span>시스템 로그</span>
</a>
      </nav>
      <div class="sidebar-bottom">
        <div class="system-status" role="status">
<span class="status-indicator" id="system-status-indicator">
</span>
<span id="system-status-text">서버 확인 중</span>
<span class="local-tag">LOCAL</span>
</div>
      </div>
    </aside>
    <div class="main-workspace">
      <header class="app-header">
        <div class="header-location">
<button class="icon-button mobile-menu" data-toggle-nav aria-label="메뉴 열기" aria-controls="main-sidebar" aria-expanded="false">{{> icon name="menu"}}</button>
<span class="header-workspace">RSS Bridge</span>
<span class="breadcrumb-separator">/</span>
<span id="page-breadcrumb">운영 개요</span>
</div>
        <div class="header-actions">
<div id="global-indicator" class="htmx-indicator" role="status">
<span class="spinner">
</span>
<span>처리 중</span>
</div>
</div>
      </header>
      <div id="flash" class="flash" role="status" aria-live="polite"></div>
      <main class="page-content" id="main-content" tabindex="-1">{{{body}}}</main>
      <footer class="workspace-footer">
<span>RSS Bridge <span class="footer-dot">·</span> RSS & Atom → Discord</span>
<span>내 알림을 위한 작은 연결</span>
</footer>
    </div>
  </div>
  <div id="source-modal-mount">
</div>
  {{> group-dialog}}
</body>
</html>

