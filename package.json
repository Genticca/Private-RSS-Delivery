{
  "name": "rss-discord-bridge",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server/app.ts",
    "build": "npm run build:server && npm run build:resources",
    "build:server": "tsc -p tsconfig.server.json",
    "build:resources": "copyfiles -u 1 \"src/resources/migrations/**/*\" \"src/resources/config/**/*\" \"src/resources/templates/**/*\" \"src/resources/presets/**/*\" dist",
    "start": "node dist/server/app.js",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.3",
    "@fastify/view": "^11.1.0",
    "@google/genai": "^1.52.0",
    "ajv": "^8.17.1",
    "better-sqlite3": "^12.10.0",
    "fast-xml-parser": "^5.7.3",
    "fastify": "^5.6.1",
    "handlebars": "^4.7.8",
    "undici": "^7.16.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "codemirror": "^5.65.21",
    "copyfiles": "^2.4.1",
    "htmx.org": "^2.0.10",
    "jsonlint-mod": "^1.7.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
