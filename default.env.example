# ────────────────────────────────────────────────────────────────────────────
# rss-discord-bridge — 환경 변수 템플릿
# 이 파일을 복사해 .env 로 만든다 (`cp default.env.example .env`).
# .env 는 .gitignore 대상이며 시크릿(API 키)은 .env 에만 둔다(이 템플릿엔 빈 값).
# 서버 설정·실행 제한은 config.ts + runtime/options.ts, 모델 키는 translator/keys.ts에서 읽는다.
# 모델 이름·prompt_log_max_bytes 등은 env가 아니라 DB(model_config)에서 관리 → Model 페이지.
#
# 실행:  npm run build && npm start      (production)
#        npm run dev                      (개발, tsx watch — NODE_ENV=development 권장)
# ────────────────────────────────────────────────────────────────────────────

# ── 런타임 모드 ──────────────────────────────────────────────────────────────
# production 으로 두면 운영 점검이 켜지고, HOST 는 loopback(127.0.0.1/localhost/::1)만 허용된다.
# (config.ts: production + 비-loopback HOST → 부팅 시 throw. 본 도구는 내부·단일 관리자 전용.)
# 로컬 개발은 development 로 둔다. 실제 서버 배포 시 production 으로 바꾼다.
NODE_ENV=development

# ── 서버 바인딩 ──────────────────────────────────────────────────────────────
# 내부 관리 도구이므로 loopback 고정. (production 에서는 loopback 외 값 사용 불가)
# 외부(Windows 브라우저 등)에서 접속해야 하면: WSL2 직접 실행 시 localhost 자동 포워딩,
# Docker 라면 포트 매핑(-p 8080:8080)으로 노출 — 단 컨테이너 내부 바인딩은 loopback 유지.
HOST=127.0.0.1
PORT=8080

# ── SQLite 데이터 파일 ───────────────────────────────────────────────────────
# 실행 시 cwd(프로젝트 루트) 기준 상대경로. data/ 는 gitignore.
DATABASE_PATH=./data/rss-discord-bridge.sqlite

# ── 번역 모델 API 키 (Gemini, env 전용 — DB 미저장) ─────────────────────────
# 비워두면 부팅은 정상이나 번역 비활성: Model 페이지에서 missing-key 로 표시되고
# 전송 시 번역 없이 원문 그대로 발송된다. 실제 번역(→ 한국어)을 쓰려면 키를 채운다.
# DB 시드 기본 모델: gemini-3.1-flash-lite → Google AI Studio 키
PRIMARY_MODEL_API_KEY=

# ── 워커·피드 실행 제한 ─────────────────────────────────────────────────────
POLL_CONCURRENCY=2
DELIVERY_CONCURRENCY=2
SHUTDOWN_TIMEOUT_MS=30000
FEED_MAX_BYTES=5242880

# 초기 baseline 제외: 신규 건수 또는 최소 건수+비율을 넘으면 검토 대기
NEW_ITEMS_HOLD_COUNT=50
NEW_ITEMS_HOLD_MIN=10
NEW_ITEMS_HOLD_RATIO=0.8

# 이 기간 동안 다시 관측되지 않은 완료 항목의 본문만 축소 (식별자·해시 보존)
ITEM_CONTENT_RETENTION_DAYS=180
