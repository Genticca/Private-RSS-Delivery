# rss-discord-bridge systemd unit
# 설치: /etc/systemd/system/rss-discord-bridge.service 로 복사 후
#   sudo systemctl daemon-reload && sudo systemctl enable --now rss-discord-bridge
# 전제: 앱 전체가 WorkingDirectory 에 배포되어 있고(.env·dist·data·node_modules 포함),
#       해당 서버에서 `npm ci && npm run build` 를 이미 완료한 상태.

[Unit]
Description=RSS to Discord Bridge (rss-discord-bridge)
Documentation=file:///opt/rss-discord-bridge/deploy/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rssbridge
Group=rssbridge

# 앱 루트. config.ts 가 cwd 기준으로 .env 와 ./data/...sqlite 를 해석하므로 반드시 정확해야 함.
WorkingDirectory=/opt/rss-discord-bridge

# .env 를 프로세스 환경변수로 로드 — API 키(PRIMARY/FALLBACK_MODEL_API_KEY)·HOST·PORT·DATABASE_PATH.
#   앱 자체는 .env 의 API 키를 process.env 로 올리지 않으므로(config.ts 는 HOST/PORT/DB 만 읽음),
#   운영에서 키를 먹이려면 이 EnvironmentFile 이 필요하다. '-' 접두사 = 파일 없어도 기동(번역만 OFF).
#   주의: systemd 는 값 줄의 인라인 '# 주석'을 미지원 → 각 줄은 반드시 `KEY=value` 형식만(주석은 줄 맨 앞 #).
EnvironmentFile=-/opt/rss-discord-bridge/.env

# NODE_ENV=production 강제. EnvironmentFile 뒤에 와서 .env 의 NODE_ENV 보다 우선 적용된다
# (production 에서는 HOST 가 반드시 loopback 이어야 기동됨).
Environment=NODE_ENV=production

# node 절대경로는 서버에 맞게 조정: `which node` (NodeSource 설치 시 보통 /usr/bin/node).
ExecStart=/usr/bin/node dist/server/main.js

# 앱은 SIGTERM 에서 워커 정지 후 단일 flight 로 graceful shutdown 함.
KillSignal=SIGTERM
# HTTP 완료와 SHUTDOWN_TIMEOUT_MS=30000 워커 drain에 충분한 시간을 확보한다.
TimeoutStopSec=90
Restart=on-failure
RestartSec=3

# 보안 하드닝 (내부·단일 관리자 도구 전제)
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
# SQLite 파일을 쓰는 data 디렉터리만 쓰기 허용
ReadWritePaths=/opt/rss-discord-bridge/data

[Install]
WantedBy=multi-user.target
